# Set these in Vercel → Project → Settings → Environment Variables
# (Production, Preview, and Development).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EBAY_MARKETPLACE_ID=EBAY_US
APIFY_TOKEN=
APIFY_FACEBOOK_ACTOR=apify~facebook-marketplace-scraper
APIFY_EBAY_ACTOR=datascrapers~ebay-scraper
APIFY_RUN_TIMEOUT_SECONDS=180
APIFY_MAX_ITEMS=5
APIFY_INGEST_SOURCES=ebay
CRAWL_ENABLED=true
CRAWL_INTERVAL_SECONDS=60
CRAWL_CATEGORIES=phones,tvs,electronics,other
OPENAI_API_KEY=
# Same-origin Vercel deploys do not need extra CORS. Add your Vercel URL if the API is hosted separately.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
