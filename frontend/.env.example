# Leave API URLs empty on Vercel so the UI calls this same deployment (/api, /health).
# Locally, Vite proxies those paths to http://localhost:8000 unless you set a URL here.
VITE_API_BASE_URL=
VITE_API_URL=
# Required for the login page. Publishable key is fine here (sb_publishable_...).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
