# Frontend (also copy into frontend/.env)
# On Vercel, leave API URLs empty so the UI uses this same deployment.
VITE_API_URL=
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend (also copy into backend/.env, or set the same names in Vercel env)
# Used to verify Supabase JWTs on user-specific routes.
# Secret key (sb_secret_...) goes in SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EBAY_APP_ID=
EBAY_CERT_ID=
APIFY_TOKEN=
OPENAI_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
